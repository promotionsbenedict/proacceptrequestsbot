# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Telegram numeric user ID of the bot administrator (get it from @userinfobot)
ADMIN_ID=123456789

# Mandatory channel every user must join before using the bot.
# Use the public @username (the bot must be a member/admin so it can read membership).
REQUIRED_CHANNEL=@proacceptrequests
REQUIRED_CHANNEL_URL=https://t.me/proacceptrequests

# Path to the SQLite database file (kept on a persistent volume in Docker)
DATABASE_PATH=data/pro_accept_requests.db

# ---------------------------------------------------------------------------
# Optional: Telethon helper userbot
# ---------------------------------------------------------------------------
# A dedicated Telegram USER account (not a bot) that lets the app read and
# approve join requests submitted BEFORE the bot became an admin, via MTProto.
# Leave these blank to disable — the bot still works and approves new requests.
#
# 1. Create a throwaway/helper Telegram account.
# 2. Get API ID + hash at https://my.telegram.org (API development tools).
# 3. Run:  python scripts/generate_session.py   and paste the result below.
HELPER_API_ID=
HELPER_API_HASH=
HELPER_SESSION=
